{
    "id": "pullWindow",
    "name": "Pull Window",
    "description": "Launcher search over open windows that pulls the chosen one onto your current workspace (Hyprland, Sway, Scroll, MangoWC and niri)",
    "version": "1.0.0",
    "license": "MIT",
    "author": "ReyArlena",
    "icon": "move_down",
    "type": "composite",
    "capabilities": [
        "window-management",
        "ipc"
    ],
    "components": {
        "launcher": "./PullWindow.qml",
        "daemon": "./PullWindowIpc.qml"
    },
    "settings": "./PullWindowSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "trigger": ":pw",
    "requires_dms": ">=2.0.0",
    "requires": [
        "jq"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
